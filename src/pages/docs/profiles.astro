    gap: 0.75rem;
    padding: 1rem;
    background: rgba(241, 77, 77, 0.1);
    border: 1px solid rgba(241, 77, 77, 0.2);
    border-radius: 8px;
    margin: 1.5rem 0;
  }

  .tip i {
    font-size: 1.25rem;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .tip strong {
    color: var(--color-text);
  }
</style>
