---

<section class="backers-section">
  <div class="backers-container">
    <span class="section-label">Supporters</span>
    <h2>Backed by the community</h2>
    <p class="backers-intro">
      Many thanks to all those who have supported the project financially!
    </p>

    <div class="backers-grid">
      {backers.map((backer) => <BackerCard backer={backer} />)}
    </div>

    <div class="backers-cta">
      <LinkButton link="https://opencollective.com/npkill"
        >Support npkill</LinkButton
      >
    </div>
  </div>
</section>

<style>
  .backers-section {
    padding: 5rem 1.5rem;
    background: var(--color-bg-darker);
  }

  .backers-container {
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
  }

  .section-label {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin: 0 0 0.75rem;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .backers-intro {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin: 0 0 2.5rem;
  }

  .backers-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin-bottom: 2.5rem;
  }

  .backers-cta {
    text-align: center;
  }

  @media (max-width: 600px) {
    .backers-section {
      padding: 3rem 1rem;
    }
  }
</style>
