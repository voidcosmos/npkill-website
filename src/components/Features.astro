---
const features = [
  {
    icon: "bx-layer",
    title: "17 Built-in Profiles",
    description:
      "Clean up Node, Python, Rust, Go, Unity, Godot, and more. One command, multiple ecosystems.",
  },
  {
    icon: "bx-zap",
    title: "Blazing Fast",
    description:
      "Low-level search that maximizes disk and CPU usage. Find gigabytes in seconds.",
  },
  {
    icon: "bx-select-multiple",
    title: "Multiselect",
    description:
      "Select multiple directories and delete them all at once. No more one-by-one.",
  },
  {
    icon: "bx-search-alt",
    title: "Smart Filter",
    description:
      "Press / to filter results by path. Supports regex for power users.",
  },
  {
    icon: "bx-cog",
    title: "Configurable",
    description:
      "Create custom profiles and set defaults with .npkillrc. Your workflow, your rules.",
  },
  {
    icon: "bx-shield-quarter",
    title: "Safe by Default",
    description:
      "Risk analyzer warns you about system-critical directories. Delete with confidence.",
  },
];
---

<section class="features-section">
  <div class="features-container">
    <div class="features-header">
      <span class="section-label">Features</span>
      <h2>Everything you need to reclaim disk space</h2>
      <p>
        npkill 1.0 brings powerful new features while staying simple to use.
      </p>
    </div>

    <div class="features-grid">
      {
        features.map((feature) => (
          <div class="feature-card">
            <div class="feature-icon">
              <i class={`bx ${feature.icon}`} />
            </div>
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </div>
        ))
      }
    </div>

    <div class="features-cta">
      <a href="/docs" class="btn btn-primary">View Documentation</a>
      <a href="/changelog" class="btn btn-ghost">What's new in 1.0</a>
    </div>
  </div>
</section>

<style>
  .features-section {
    padding: 6rem 1.5rem;
    background: var(--color-bg-darker);
    position: relative;
  }

  .features-section::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-border),
      transparent
    );
  }

  .features-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .features-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 4rem;
  }

  .section-label {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .features-header h2 {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
  }

  .features-header p {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .feature-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.75rem;
    transition: all 0.2s ease;
  }

  .feature-card:hover {
    border-color: var(--color-border-light);
    transform: translateY(-2px);
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(241, 77, 77, 0.1);
    border-radius: 10px;
    margin-bottom: 1.25rem;
  }

  .feature-icon i {
    font-size: 1.5rem;
    color: var(--color-primary);
  }

  .feature-card h3 {
    font-size: 1.1rem;
    margin: 0 0 0.5rem;
    font-weight: 600;
  }

  .feature-card p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .features-cta {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 3rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    font-size: 0.95rem;
    font-weight: 500;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-primary {
    background: var(--color-primary);
    color: white;
  }

  .btn-primary:hover {
    background: var(--color-primary-dark);
    color: white;
  }

  .btn-ghost {
    color: var(--color-text-muted);
  }

  .btn-ghost:hover {
    color: var(--color-text);
  }

  @media (max-width: 900px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .features-section {
      padding: 4rem 1rem;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }

    .features-cta {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
