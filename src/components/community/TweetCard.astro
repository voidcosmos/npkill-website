---
import { type Tweet } from "./tweet.interface";

interface Props {
  profile: Tweet;
}

const { profile } = Astro.props;
const { profileImg, name, text, mediaSrc, date, source } = profile;
---

<a href={source} target="_blank" rel="noopener" class="tweet-link">
  <div class="tweet-card">
    <div class="tweet-header">
      <img
        class="profile-image"
        loading="lazy"
        src={profileImg}
        alt={name + " profile image"}
      />
      <div class="tweet-meta">
        <div class="name">{name}</div>
        <div class="date">
          {`${date.getDate()}/${date.getMonth() + 1}/${date.getFullYear()}`}
        </div>
      </div>
    </div>

    <div class="tweet-body">
      <p>{text}</p>

      {
        mediaSrc && (
          <div class="tweet-media">
            <img src={mediaSrc} loading="lazy" alt="Tweet media" />
          </div>
        )
      }
    </div>
  </div>
</a>

<style>
  .tweet-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .tweet-card {
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1rem;
    transition: border-color 0.2s;
    text-align: left;
  }

  .tweet-card:hover {
    border-color: var(--color-border-light);
  }

  .tweet-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .profile-image {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 2px solid var(--color-border);
  }

  .tweet-meta {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .name {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .date {
    font-size: 0.75rem;
    color: var(--color-text-subtle);
  }

  .tweet-body {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .tweet-body p {
    margin: 0;
    white-space: pre-line;
  }

  .tweet-media {
    margin-top: 0.75rem;
    border-radius: 8px;
    overflow: hidden;
  }

  .tweet-media img {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
