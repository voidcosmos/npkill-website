---
import { Image } from "astro:assets";
const { backer } = Astro.props;
const { name, amount, imgUrl, text = "" } = backer;
---

<div class="backer-card">
  <Image src={imgUrl} alt={name + " avatar"} width="48" height="48" />
  <div class="backer-info">
    <div class="name">{name}</div>
    <div class="amount">${amount}</div>
  </div>
  {text && <div class="text">"{text}"</div>}
</div>

<style>
  .backer-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    width: 140px;
    padding: 1rem 0.75rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    text-align: center;
    transition: border-color 0.2s;
  }

  .backer-card:hover {
    border-color: var(--color-border-light);
  }

  img {
    border-radius: 50%;
    width: 48px;
    height: 48px;
    border: 2px solid var(--color-border);
  }

  .backer-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .name {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 120px;
  }

  .amount {
    font-size: 0.8rem;
    color: var(--color-primary);
    font-weight: 500;
  }

  .text {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    font-style: italic;
    line-height: 1.3;
    max-width: 120px;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
</style>
