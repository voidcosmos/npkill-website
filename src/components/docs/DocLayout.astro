---
import Layout from "../../layouts/Layout.astro";
import Footer from "../Footer.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const currentPath = Astro.url.pathname;

const sidebarLinks = [
  { href: "/docs/commands", label: "Commands & Options", icon: "bx-terminal" },
  { href: "/docs/profiles", label: "Profiles", icon: "bx-layer" },
  {
    href: "/docs/npkillrc",
    label: "Configuration (.npkillrc)",
    icon: "bx-cog",
  },
];

function isActive(href: string): boolean {
  return currentPath === href || currentPath === href + "/";
}
---

<Layout title={`${title} | npkill docs`} description={description}>
  <div class="doc-layout">
    <aside class="sidebar">
      <div class="sidebar-content">
        <div class="sidebar-header">
          <span class="sidebar-title">Documentation</span>
        </div>
        <nav class="sidebar-nav">
          {
            sidebarLinks.map((link) => (
              <a
                href={link.href}
                class:list={["sidebar-link", { active: isActive(link.href) }]}
              >
                <i class={`bx ${link.icon}`} />
                {link.label}
              </a>
            ))
          }
        </nav>

        <div class="sidebar-footer">
          <a
            href="https://github.com/voidcosmos/npkill/releases/tag/v1.0.0"
            target="_blank"
            rel="noopener"
            class="sidebar-link changelog-link"
          >
            <i class="bx bx-news"></i>
            What's new in 1.0
          </a>
        </div>
      </div>
    </aside>

    <main class="doc-content">
      <article class="doc-article">
        <slot />
      </article>
      <Footer />
    </main>
  </div>
</Layout>

<style>
  .doc-layout {
    display: flex;
    min-height: calc(100vh - 64px);
  }

  .sidebar {
    width: 280px;
    flex-shrink: 0;
    border-right: 1px solid var(--color-border);
    background: var(--color-bg-darker);
    position: sticky;
    top: 64px;
    height: calc(100vh - 64px);
    overflow-y: auto;
  }

  .sidebar-content {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem 1rem;
  }

  .sidebar-header {
    padding: 0 0.75rem;
    margin-bottom: 1rem;
  }

  .sidebar-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.15s ease;
  }

  .sidebar-link:hover {
    color: var(--color-text);
    background: var(--color-bg-elevated);
  }

  .sidebar-link.active {
    color: var(--color-primary);
    background: rgba(241, 77, 77, 0.1);
  }

  .sidebar-link i {
    font-size: 1.1rem;
  }

  .sidebar-footer {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .changelog-link {
    color: var(--color-primary) !important;
  }

  .doc-content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .doc-article {
    flex: 1;
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem;
    width: 100%;
  }

  .doc-article :global(h1) {
    font-size: 2.25rem;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }

  .doc-article :global(h2) {
    font-size: 1.5rem;
    margin: 2.5rem 0 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .doc-article :global(h3) {
    font-size: 1.2rem;
    margin: 2rem 0 0.75rem;
  }

  .doc-article :global(p) {
    margin: 0 0 1rem;
    color: var(--color-text-muted);
  }

  .doc-article :global(ul),
  .doc-article :global(ol) {
    margin: 0 0 1.5rem;
    padding-left: 1.5rem;
    color: var(--color-text-muted);
  }

  .doc-article :global(li) {
    margin-bottom: 0.5rem;
  }

  .doc-article :global(.table-scroll) {
    overflow-x: auto;
  }

  .doc-article :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9rem;
  }

  .doc-article :global(th),
  .doc-article :global(td) {
    padding: 0.75rem 1rem;
    text-align: left;
    border: 1px solid var(--color-border);
  }

  .doc-article :global(th) {
    background: var(--color-bg-elevated);
    font-weight: 600;
    color: var(--color-text);
  }

  .doc-article :global(td) {
    color: var(--color-text-muted);
  }

  .doc-article :global(td code) {
    font-size: 0.85rem;
  }

  @media (max-width: 900px) {
    .sidebar {
      display: none;
    }

    .doc-article {
      padding: 1.5rem 1rem;
    }
  }
</style>
