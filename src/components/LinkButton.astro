---
const { link, filled = true } = Astro.props;
---

<a
  href={link}
  target="_blank"
  rel="noopener"
  class:list={["button", { filled }]}
>
  <slot />
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
    cursor: pointer;
    padding: 0.6rem 1.25rem;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .button:hover {
    background: var(--color-bg-card);
    border-color: var(--color-border-light);
    color: var(--color-text);
  }

  .filled {
    border: none;
    background: var(--color-primary);
    color: white;
  }

  .filled:hover {
    background: var(--color-primary-dark);
    color: white;
  }
</style>
