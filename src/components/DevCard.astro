---
import { Image } from "astro:assets";

interface Link {
  name: string;
  icon: string;
  link: string;
}

interface Props {
  image: string;
  name: string;
  links: Link[];
}

const { image, name, links = [] } = Astro.props;
---

<div class="dev-card">
  <div class="avatar">
    <Image src={image} alt={name + " avatar"} width="96" height="96" />
  </div>

  <div class="info">
    <div class="name">{name}</div>

    <div class="links">
      {
        links.map((link) => (
          <a
            href={link.link}
            target="_blank"
            rel="noopener"
            class="social-link"
            title={link.name}
          >
            <i class={"bx " + link.icon} />
          </a>
        ))
      }
    </div>
  </div>
</div>

<style>
  .dev-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--color-bg-card);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    transition: border-color 0.2s;
    min-width: 180px;
  }

  .dev-card:hover {
    border-color: var(--color-border-light);
  }

  .avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--color-border);
  }

  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .name {
    font-size: 1.1rem;
    font-weight: 600;
    text-align: center;
    color: var(--color-text);
  }

  .info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .links {
    display: flex;
    gap: 0.5rem;
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-text-muted);
    font-size: 1.1rem;
    transition: all 0.2s;
  }

  .social-link:hover {
    color: var(--color-text);
    border-color: var(--color-border-light);
    background: var(--color-bg-card);
  }
</style>
