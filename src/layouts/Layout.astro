---
import Nav from "../components/Nav.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "List any node_modules 📦 dir in your system and how heavy they are. You can then select which ones you want to erase to free up space 🧹.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css"
      rel="stylesheet"
    />
    <meta
      name="keywords"
      content="npkill, node_modules, npm, node, javascript, tool, optimization, cli, disk space, cleanup, profiles"
    />
    <meta property="og:title" content={title} />
    <meta name="description" content={description} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="npkill" />
    <meta property="og:url" content="https://npkill.js.org" />
    <meta property="og:type" content="website" />
    <meta
      property="og:image"
      content="https://npkill.js.org/img/og-npkill.webp"
    />
    <meta
      name="google-site-verification"
      content="umq3bDhuCGbYZbwjbAt1ufhgUoxTUHmKCUQZYnWvl_Y"
    />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="apple-touch-icon" type="image/png" href="favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    <Nav />
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* New npkill brand colors */
    --color-primary: #f14d4d;
    --color-primary-dark: #c73e3e;
    --color-primary-light: #ff6b6b;

    /* Neutral palette */
    --color-bg-dark: #0a0a0b;
    --color-bg-darker: #050506;
    --color-bg-card: #111113;
    --color-bg-elevated: #1a1a1d;

    --color-text: #e4e4e7;
    --color-text-muted: #a1a1aa;
    --color-text-subtle: #71717a;

    --color-border: #27272a;
    --color-border-light: #3f3f46;

    /* Semantic */
    --color-warning: #fbbf24;
    --color-success: #22c55e;

    /* Legacy support */
    --accent: 241, 77, 77;
    --accent-light: 255, 107, 107;
    --accent-dark: 199, 62, 62;
  }

  * {
    box-sizing: border-box;
  }

  html {
    font-family:
      "Inter",
      system-ui,
      -apple-system,
      sans-serif;
    background-color: var(--color-bg-dark);
    color: var(--color-text);
    font-size: 18px;
    line-height: 1.7;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    overflow-x: hidden;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    color: var(--color-text);
    font-weight: 600;
    line-height: 1.3;
  }

  a {
    color: var(--color-primary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  a:hover {
    color: var(--color-primary-light);
  }

  code {
    font-family: "JetBrains Mono", Menlo, Monaco, Consolas, monospace;
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.15em 0.4em;
    font-size: 0.9em;
    color: var(--color-primary-light);
  }

  kbd {
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.1em 0.4em;
    font-family: inherit;
    font-size: 0.85em;
    box-shadow: 0 2px 0 var(--color-border);
  }

  .content {
    margin: auto;
    padding: 1rem;
    width: 900px;
    max-width: calc(100% - 2rem);
  }

  /* Utility classes */
  .text-primary {
    color: var(--color-primary);
  }
  .text-muted {
    color: var(--color-text-muted);
  }
  .text-center {
    text-align: center;
  }

  .mt-1 {
    margin-top: 0.5rem;
  }
  .mt-2 {
    margin-top: 1rem;
  }
  .mt-3 {
    margin-top: 1.5rem;
  }
  .mt-4 {
    margin-top: 2rem;
  }
  .mb-1 {
    margin-bottom: 0.5rem;
  }
  .mb-2 {
    margin-bottom: 1rem;
  }
  .mb-3 {
    margin-bottom: 1.5rem;
  }
  .mb-4 {
    margin-bottom: 2rem;
  }
</style>
